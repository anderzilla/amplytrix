{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amplytrix:schema:v1:baseline-decision",
  "title": "Amplytrix baseline decision v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "project_id",
    "scenario_id",
    "status",
    "decided_by",
    "authority_ref",
    "decided_at",
    "scope",
    "cost",
    "schedule",
    "acceptance_criteria",
    "client_dependencies",
    "exclusions",
    "change_policy"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "$ref": "common.schema.json#/$defs/version" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "project_id": { "$ref": "common.schema.json#/$defs/id" },
    "scenario_id": { "$ref": "common.schema.json#/$defs/id" },
    "status": { "enum": ["proposed", "accepted", "rejected", "superseded"] },
    "decided_by": { "type": "string", "minLength": 1 },
    "authority_ref": { "type": "string", "minLength": 1 },
    "decided_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "scope": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "cost": { "$ref": "common.schema.json#/$defs/cost" },
    "schedule": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "client_dependencies": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "exclusions": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "change_policy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
