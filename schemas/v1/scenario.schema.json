{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amplytrix:schema:v1:scenario",
  "title": "Amplytrix scenario v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "project_id",
    "kind",
    "status",
    "summary",
    "gains",
    "renunciations",
    "client_effort",
    "risks",
    "advantages",
    "timeline",
    "cost",
    "consequences",
    "assumptions",
    "evidence_refs"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "$ref": "common.schema.json#/$defs/version" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "project_id": { "$ref": "common.schema.json#/$defs/id" },
    "kind": { "enum": ["conservative", "realistic", "aggressive", "custom"] },
    "status": { "enum": ["draft", "proposed", "selected", "rejected", "superseded"] },
    "summary": { "type": "string", "minLength": 1 },
    "gains": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "renunciations": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "client_effort": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "risks": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "advantages": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "timeline": { "type": "string", "minLength": 1 },
    "cost": { "$ref": "common.schema.json#/$defs/cost" },
    "consequences": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "assumptions": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" },
    "evidence_refs": { "$ref": "common.schema.json#/$defs/nonEmptyStrings" }
  },
  "additionalProperties": false
}
