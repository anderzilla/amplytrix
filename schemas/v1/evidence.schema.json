{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amplytrix:schema:v1:evidence",
  "title": "Amplytrix evidence v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "project_id",
    "task_id",
    "claim",
    "polarity",
    "status",
    "source_refs",
    "observed_at",
    "recorded_by",
    "confidence",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "$ref": "urn:amplytrix:schema:v1:common#/$defs/version" },
    "id": { "$ref": "urn:amplytrix:schema:v1:common#/$defs/id" },
    "project_id": { "$ref": "urn:amplytrix:schema:v1:common#/$defs/id" },
    "task_id": { "type": "string", "minLength": 1 },
    "claim": { "type": "string", "minLength": 1 },
    "polarity": { "enum": ["favorable", "contrary", "inconclusive"] },
    "status": { "enum": ["proposed", "verified", "disputed", "superseded"] },
    "source_refs": { "$ref": "urn:amplytrix:schema:v1:common#/$defs/nonEmptyStrings" },
    "observed_at": { "$ref": "urn:amplytrix:schema:v1:common#/$defs/timestamp" },
    "recorded_by": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["low", "medium", "high"] },
    "limitations": { "$ref": "urn:amplytrix:schema:v1:common#/$defs/nonEmptyStrings" },
    "review_ref": { "type": "string" }
  },
  "additionalProperties": false
}
